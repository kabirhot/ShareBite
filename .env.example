# Optional settings for the backend. The project runs without any of these.
# To use one, set it as an environment variable before starting the server.

# Port the server listens on
PORT=8080

# Other addresses allowed to call the API (comma separated). 5500 = VS Code Live Server.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# true  = demo: OTP is shown on the page and printed in the server console
# false = OTP is not shown anywhere (use only after connecting a real email/SMS service)
OTP_DEMO_MODE=true

# Database settings normally go in backend/db.properties.
# These environment variables, if set, are used instead.
# DB_URL=jdbc:mysql://localhost:3306/sharebite?createDatabaseIfNotExist=true
# DB_USER=root
# DB_PASSWORD=
