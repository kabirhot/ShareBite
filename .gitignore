.env
.env.*
!.env.example

# Editors and OS files
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.lnk
*.log

# The JDBC driver is downloaded by run.bat, so the jar is not stored in git
backend/lib/*.jar
